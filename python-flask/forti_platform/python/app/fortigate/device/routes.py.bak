from __future__ import annotations
from typing import List, Dict, Any, Optional
from flask import request, jsonify, session

from . import forti_device_bp
from app.utils.utils import log_operation, audit_event
from .db.device_handler import (
    list_devices, get_device, create_device, update_device, delete_device,
    list_device_vdoms, upsert_device_vdoms
)

import requests
import urllib3
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)


# ---- Helpers ----
def _norm_str(x: Any) -> str:
    return (str(x) if x is not None else "").strip()

def _as_int(x: Any, default: int) -> int:
    try:
        return int(x)
    except Exception:
        return default

def _validate_device_payload(data: Dict[str, Any], *, partial: bool = False) -> Optional[str]:
    """
    partial=True 用於 PUT（允許部分欄位），POST 則要求必填。
    """
    need = ["name", "host", "api_token"] if not partial else []
    for k in need:
        if not _norm_str(data.get(k)):
            return f"missing key: {k}"

    if "port" in data and data["port"] is not None:
        try:
            p = int(data["port"])
            if p <= 0 or p > 65535:
                return "port out of range"
        except Exception:
            return "port must be integer"
    if "verify_ssl" in data and str(data["verify_ssl"]) not in {"0", "1", "true", "false"}:
        return "verify_ssl must be 0/1"
    if "is_active" in data and str(data["is_active"]) not in {"0", "1", "true", "false"}:
        return "is_active must be 0/1"
    return None

def _probe_device(host: str, port: int, token: str, verify_ssl: bool) -> Dict[str, Any]:
    """
    輕量探測 FortiGate：打 system/global 或 system/status 其中之一成功即可。
    僅回傳成功/失敗與延遲；不回傳敏感內容。
    """
    base = f"https://{host}:{port}"
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    ok = False
    ms = None
    target = None
    for path in ("/api/v2/cmdb/system/global", "/api/v2/monitor/system/status"):
        url = f"{base}{path}"
        try:
            import time
            t0 = time.time()
            r = requests.get(url, headers=headers, timeout=8, verify=verify_ssl)
            ms = int((time.time() - t0) * 1000)
            if 200 <= r.status_code < 300:
                ok = True
                target = path
                break
        except Exception:
            pass
    return {"ok": ok, "latency_ms": ms, "endpoint": target}


# ---- Devices ----
@forti_device_bp.get("/devices")
def api_device_list():
    items = list_devices()
    log_operation(session.get("username"), "device_list", None)
    return jsonify({"ok": True, "items": items})

@forti_device_bp.post("/devices")
@audit_event(action="device_create", entity_type="device",
             entity_id=lambda res: (res.get_json() or {}).get("id"),
             details=lambda res: request.json)
def api_device_create():
    data = request.get_json(silent=True) or {}
    err = _validate_device_payload(data, partial=False)
    if err:
        return jsonify({"ok": False, "error": err}), 400

    name = _norm_str(data.get("name"))
    host = _norm_str(data.get("host"))
    api_token = _norm_str(data.get("api_token"))
    port = _as_int(data.get("port", 443), 443)
    is_active = 1 if str(data.get("is_active", 1)).lower() in {"1","true"} else 0
    verify_ssl = 1 if str(data.get("verify_ssl", 1)).lower() in {"1","true"} else 0

    new_id = create_device(
        name=name, host=host, port=port, api_token=api_token,
        is_active=is_active, verify_ssl=verify_ssl
    )
    log_operation(session.get("username"), "device_create", {"id": new_id})
    return jsonify({"ok": True, "id": new_id}), 201

@forti_device_bp.put("/devices/<int:device_id>")
@audit_event(action="device_update", entity_type="device", entity_id="device_id",
             details=lambda res: request.json)
def api_devices_update(device_id: int):
    data = request.get_json(silent=True) or {}
    err = _validate_device_payload(data, partial=True)
    if err:
        return jsonify({"ok": False, "error": err}), 400

    dev = get_device(device_id)
    if not dev:
        return jsonify({"ok": False, "error": "device not found"}), 404

    name = _norm_str(data.get("name", dev["name"]))
    host = _norm_str(data.get("host", dev["host"]))
    port = _as_int(data.get("port", dev["port"]), dev["port"])
    is_active = 1 if str(data.get("is_active", dev["is_active"])).lower() in {"1","true"} else 0
    verify_ssl = 1 if str(data.get("verify_ssl", dev["verify_ssl"])).lower() in {"1","true"} else 0

    # 若 UI 不要改 token，可不傳；若傳空字串則忽略（避免意外清空）
    api_token = data.get("api_token", None)
    if isinstance(api_token, str) and api_token.strip() == "":
        api_token = None

    update_device(device_id, name, host, port, is_active, verify_ssl, api_token=api_token)
    log_operation(session.get("username"), "device_update", {"id": device_id})
    return jsonify({"ok": True, "id": device_id})

@forti_device_bp.delete("/devices/<int:device_id>")
@audit_event(action="device_delete", entity_type="device", entity_id="device_id")
def api_devices_delete(device_id: int):
    if not get_device(device_id):
        return jsonify({"ok": False, "error": "device not found"}), 404
    delete_device(device_id)
    log_operation(session.get("username"), "device_delete", {"id": device_id})
    return jsonify({"ok": True})

# ---- VDOMs ----
@forti_device_bp.get("/devices/<int:device_id>/vdoms")
def api_device_vdoms(device_id: int):
    if not get_device(device_id):
        return jsonify({"ok": False, "error": "device not found"}), 404
    vdoms = list_device_vdoms(device_id)
    log_operation(session.get("username"), "device_vdoms_list", {"device_id": device_id})
    return jsonify({"ok": True, "vdoms": vdoms})

@forti_device_bp.post("/devices/<int:device_id>/vdoms")
@audit_event(action="device_vdoms_upsert", entity_type="device", entity_id="device_id",
             details=lambda res: request.json)
def api_device_vdoms_upsert(device_id: int):
    data = request.get_json(silent=True) or {}
    vdoms: List[str] = data.get("vdoms") or []
    if not get_device(device_id):
        return jsonify({"ok": False, "error": "device not found"}), 404
    upsert_device_vdoms(device_id, vdoms)
    log_operation(session.get("username"), "device_vdoms_upsert", {"device_id": device_id, "vdoms": vdoms})
    return jsonify({"ok": True, "device_id": device_id, "vdoms": sorted(vdoms, key=str.lower)})

# ---- Probe ----
@forti_device_bp.get("/devices/<int:device_id>/probe")
@audit_event(action="device_probe", entity_type="device", entity_id="device_id")
def api_device_probe(device_id: int):
    dev = get_device(device_id)
    if not dev:
        return jsonify({"ok": False, "error": "device not found"}), 404
    res = _probe_device(dev["host"], int(dev["port"]), dev.get("api_token") or "", bool(dev["verify_ssl"]))
    log_operation(session.get("username"), "device_probe", {"device_id": device_id, **res})
    return jsonify({"ok": True, **res})

